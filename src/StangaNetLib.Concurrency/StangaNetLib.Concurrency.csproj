<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <AssemblyName>StangaNetLib.Concurrency</AssemblyName>
    <RootNamespace>StangaNetLib.Concurrency</RootNamespace>
    <Description>Simplified threading, multi-threading and concurrent data access utilities: keyed locks, async throttling, bounded work queues, debouncing, and atomic counters.</Description>
    <PackageTags>concurrency;threading;async;locking;channels;stangaNet</PackageTags>
    <Version>1.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="StangaNetLib.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StangaNetLib.Concurrency.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
